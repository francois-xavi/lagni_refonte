---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PrivacyPage from '../../../components/pages/PrivacyPage.astro';
import { usePages } from '../../../i18n/utils';

const lang = 'en' as const;
const p = usePages(lang).privacy;
---

<BaseLayout lang={lang} routeKey="privacy" title={p.seo.title} description={p.seo.description}>
  <PrivacyPage lang={lang} />
</BaseLayout>
