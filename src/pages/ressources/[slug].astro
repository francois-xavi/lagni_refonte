---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/pages/ArticlePage.astro';
import { href, HREFLANG } from '../../i18n/routes';
import { getResources } from '../../lib/resources';

// Server rendered: the slug is resolved per request instead of being
// enumerated at build time. Drafts are not routed — an unpublished or
// unknown slug is a 404, exactly as before.
const lang = 'fr' as const;
const { slug = '' } = Astro.params;
const found = await getCollection(
  'resources',
  (e) => e.id === `fr/${slug}` && e.data.status === 'published',
);
const entry = found[0];
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);
const all = await getResources(lang);
const resource = all.find((r) => r.slug === slug)!;
const related = all.filter((r) => r.slug !== slug).slice(0, 3);

// Articles live under the Resources route, so canonical and hreflang are built
// from the slug rather than the static route table. An alternate is emitted
// only when the same slug actually exists in the other language.
const selfPath = `${href('resources', lang)}${slug}/`;
const otherEntries = await getCollection('resources', (e) => e.id === `en/${slug}`);
const alternatePaths = [
  { hreflang: HREFLANG[lang], path: selfPath },
  ...(otherEntries.length
    ? [{ hreflang: HREFLANG['en'], path: `${href('resources', 'en')}${slug}/` }]
    : []),
];
---

<BaseLayout
  lang={lang}
  routeKey="resources"
  title={`${entry.data.title} — Lagni Consulting`}
  description={entry.data.description}
  noindex={entry.data.status === 'draft'}
  canonicalPath={selfPath}
  alternatePaths={alternatePaths}
>
  <ArticlePage lang={lang} resource={resource} related={related}>
    <Content />
  </ArticlePage>
</BaseLayout>
