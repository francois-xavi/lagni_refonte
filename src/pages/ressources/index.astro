---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourcesPage from '../../components/pages/ResourcesPage.astro';
import { usePages } from '../../i18n/utils';

const lang = 'fr' as const;
const p = usePages(lang).resources;
---

<BaseLayout lang={lang} routeKey="resources" title={p.seo.title} description={p.seo.description}>
  <ResourcesPage lang={lang} />
</BaseLayout>
