---
import Icon from '../components/Icon.astro';
import Figure from './Figure.astro';
import type { ResourcePreview } from '../lib/resources';
import { publicImage } from '../lib/assets';
import { href, type Lang } from '../i18n/routes';
import { formatDate, usePages } from '../i18n/utils';

interface Props {
  resource: ResourcePreview;
  lang: Lang;
  readLabel: string;
  draftLabel?: string;
  showImage?: boolean;
  /** `featured`: large lead card · `row`: horizontal compact card. */
  variant?: 'default' | 'featured' | 'row';
}

const { resource, lang, readLabel, draftLabel, showImage = true, variant = 'default' } = Astro.props;
const url = `${href('resources', lang)}${resource.slug}/`;
const image = resource.image ? publicImage(resource.image) : undefined;
const levelLabel = usePages(lang).resources.levels[resource.level];
const categoryLabel: Record<string, string> = {
  'sap-pp': 'SAP PP',
  erp: 'ERP',
  tools: lang === 'fr' ? 'Outils' : 'Tools',
  careers: lang === 'fr' ? 'Carrières' : 'Careers',
  teaching: lang === 'fr' ? 'Enseignement' : 'Teaching',
};
const size = variant === 'featured' ? { width: 1280, height: 720 } : { width: 640, height: 360 };
---

<article class:list={['rc', `rc--${variant}`]}>
  {
    showImage && (
      <div class="rc__media">
        <Figure
          src={image}
          alt=""
          slotName={`resource-${resource.slug}`}
          width={size.width}
          height={size.height}
          rounded={false}
          fallback="brand"
          fallbackIcon="book"
          class="rc__img"
        />
        <span class="rc__cat">{categoryLabel[resource.category]}</span>
      </div>
    )
  }
  <div class="rc__body">
    <p class="rc__level">{levelLabel}</p>
    <h3 class="rc__title">
      <a href={url}>{resource.title}</a>
    </h3>
    <p class="rc__desc">{resource.description}</p>
    <div class="rc__foot">
      <div class="rc__meta">
        <span><Icon name="calendar" size={14} />{formatDate(resource.date, lang)}</span>
        <span><Icon name="clock" size={14} />{resource.readingMinutes} min</span>
        {resource.status === 'draft' && draftLabel && <span class="rc__draft">{draftLabel}</span>}
      </div>
      <span class="rc__link" aria-hidden="true">
        <span class="rc__linkLabel">{readLabel}</span>
        <span class="rc__arrow"><Icon name="arrow-right" size={15} /></span>
      </span>
    </div>
  </div>
</article>

<style>
  .rc {
    --rc-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(10, 30, 60, 0.04);
    transition-property: transform, box-shadow, border-color;
    transition-duration: 0.35s;
    transition-timing-function: var(--rc-ease);
  }

  .rc:hover,
  .rc:focus-within {
    transform: translateY(-4px);
    border-color: var(--blue-100);
    box-shadow:
      0 2px 6px rgba(10, 30, 60, 0.05),
      0 18px 40px -12px rgba(0, 74, 173, 0.22);
  }

  /* ── Media ── */

  .rc__media {
    position: relative;
    overflow: hidden;
    background: var(--blue-100);
  }

  .rc__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 20, 60, 0.28) 0%, transparent 38%);
    pointer-events: none;
  }

  .rc__media :global(.rc__img) {
    height: 100%;
    transition: transform 0.7s var(--rc-ease);
  }

  .rc__media :global(img.rc__img) {
    display: block;
  }

  .rc:hover .rc__media :global(.rc__img),
  .rc:focus-within .rc__media :global(.rc__img) {
    transform: scale(1.05);
  }

  .rc__cat {
    position: absolute;
    z-index: 1;
    top: var(--s-4);
    left: var(--s-4);
    padding: 0.3rem 0.7rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white);
    background: rgba(0, 38, 92, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    backdrop-filter: blur(8px);
  }

  /* ── Body ── */

  .rc__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-6);
    flex: 1;
  }

  .rc__level {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orange-700);
  }

  .rc__level::before {
    content: '';
    width: 1.25rem;
    height: 2px;
    background: var(--orange-500);
    border-radius: 2px;
  }

  .rc__title {
    font-size: var(--fs-lg);
    font-weight: 800;
    line-height: var(--lh-snug);
    letter-spacing: -0.01em;
  }

  .rc__title a {
    color: var(--blue-900);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition:
      color 0.25s ease,
      background-size 0.35s var(--rc-ease);
  }

  /* Make the whole card clickable while keeping one tab stop. */
  .rc__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .rc:hover .rc__title a,
  .rc__title a:focus-visible {
    color: var(--blue-700);
    background-size: 100% 1px;
  }

  .rc__title a:focus-visible {
    outline: none;
  }

  .rc:has(.rc__title a:focus-visible) {
    outline: 3px solid var(--blue-900);
    outline-offset: 3px;
    box-shadow: 0 0 0 6px var(--white);
  }

  .rc__desc {
    margin-bottom: var(--s-3);
    color: var(--muted);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .rc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: auto;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .rc__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .rc__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .rc__draft {
    padding: 0.1rem 0.45rem;
    font-weight: 700;
    color: var(--orange-700);
    background: var(--orange-050);
    border: 1px solid var(--orange-200);
    border-radius: var(--radius-sm);
  }

  .rc__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--blue-700);
  }

  .rc__arrow {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--blue-700);
    background: var(--blue-050);
    transition:
      transform 0.35s var(--rc-ease),
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .rc:hover .rc__arrow,
  .rc:focus-within .rc__arrow {
    transform: translateX(4px);
    color: var(--white);
    background: var(--orange-650);
  }

  /* ── Featured ── */

  .rc--featured .rc__body {
    padding: var(--s-8);
  }

  .rc--featured .rc__title {
    font-size: var(--fs-2xl);
  }

  .rc--featured .rc__desc {
    font-size: var(--fs-md);
  }

  /* ── Row ── */

  @media (min-width: 640px) {
    .rc--row {
      flex-direction: row;
    }

    .rc--row .rc__media {
      flex: 0 0 42%;
      min-height: 12rem;
    }

    .rc--row .rc__media :global(.rc__img) {
      position: absolute;
      inset: 0;
      width: 100%;
      aspect-ratio: auto !important;
    }

    .rc--row .rc__body {
      padding: var(--s-6);
    }

    .rc--row .rc__desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rc,
    .rc__media :global(.rc__img),
    .rc__arrow {
      transition: none;
    }

    .rc:hover,
    .rc:focus-within,
    .rc:hover .rc__media :global(.rc__img),
    .rc:focus-within .rc__media :global(.rc__img) {
      transform: none;
    }
  }
</style>
