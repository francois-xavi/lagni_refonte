---
/** The dark closing band that ends every page in the mockups. */
import Figure from './Figure.astro';

interface Props {
  title: string;
  body?: string;
  script?: string;
  imageSrc?: string;
  imageSlot?: string;
}

const { title, body, script, imageSrc, imageSlot = 'CTA background' } = Astro.props;
const titleWords = title.split(' ');
---

<section class="cta" data-reveal="cta">
  {
    imageSrc && (
      <div class="cta__media" aria-hidden="true">
        <Figure
          src={imageSrc}
          alt=""
          slotName={imageSlot}
          width={1600}
          height={500}
          rounded={false}
          class="cta__img"
        />
      </div>
    )
  }

  <div class="container cta__inner">
    <div class="cta__copy">
      <h2>
        {
          titleWords.map((word, i) => (
            <>
              <span class="cta__word" style={`--w:${i}`}>{word}</span>
              {i < titleWords.length - 1 && ' '}
            </>
          ))
        }
      </h2>
      {body && <p>{body}</p>}
    </div>
    <div class="cta__actions">
      <slot />
    </div>
    {script && <p class="script cta__script">{script}</p>}
  </div>
</section>

<script>
  import '../scripts/reveal';
</script>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    background: var(--blue-800);
    color: var(--white);
    overflow: hidden;
  }

  .cta__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.35;
  }

  .cta__media :global(.cta__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto !important;
    border-radius: 0;
  }

  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      var(--blue-800) 0%,
      rgba(0, 58, 135, 0.94) 55%,
      rgba(0, 46, 107, 0.82) 100%
    );
  }

  .cta__inner {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-12);
    align-items: center;
  }

  .cta__copy h2 {
    color: var(--white);
    max-width: 20ch;
  }

  .cta__copy p {
    margin-top: var(--s-3);
    color: rgba(255, 255, 255, 0.88);
    max-width: 52ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .cta__script {
    max-width: 20ch;
  }

  @media (min-width: 1150px) {
    .cta__inner {
      grid-template-columns: minmax(0, 1.4fr) auto auto;
      gap: var(--s-10);
    }

    .cta__script {
      justify-self: end;
      text-align: right;
    }

    .cta__script::after {
      margin-left: auto;
    }
  }

  /* ── Entrance ── */

  .cta {
    --cta-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cta__word {
    display: inline-block;
  }

  .cta,
  .cta__word,
  .cta__copy p,
  .cta__actions,
  .cta__script {
    transition-property: opacity, transform;
    transition-duration: 0.65s;
    transition-timing-function: var(--cta-ease);
  }

  .cta__word {
    transition-delay: calc(0.15s + var(--w, 0) * 0.08s);
  }

  .cta__copy p {
    transition-delay: 0.55s;
  }

  .cta__actions {
    transition-delay: 0.7s;
  }

  .cta__script {
    transition-duration: 0.8s;
    transition-delay: 0.85s;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-ready) .cta:not(.is-visible) {
      opacity: 0;
      transform: translateY(24px);
    }

    :global(.reveal-ready) .cta:not(.is-visible) .cta__word {
      opacity: 0;
      transform: translateY(0.45em);
    }

    :global(.reveal-ready) .cta:not(.is-visible) .cta__copy p {
      opacity: 0;
      transform: translateY(16px);
    }

    :global(.reveal-ready) .cta:not(.is-visible) .cta__actions {
      opacity: 0;
      transform: scale(0.92);
    }

    :global(.reveal-ready) .cta:not(.is-visible) .cta__script {
      opacity: 0;
      transform: translateX(24px);
    }
  }

  /* ── Button hover ── */

  .cta__actions :global(.btn--primary) {
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      transform 0.3s var(--cta-ease),
      box-shadow 0.3s var(--cta-ease);
  }

  .cta__actions :global(.btn--primary:hover),
  .cta__actions :global(.btn--primary:focus-visible) {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -10px rgba(255, 145, 77, 0.6);
  }

  .cta__actions :global(.btn--primary .btn__icon) {
    transition: transform 0.3s var(--cta-ease);
  }

  .cta__actions :global(.btn--primary:hover .btn__icon),
  .cta__actions :global(.btn--primary:focus-visible .btn__icon) {
    transform: translateX(5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .cta__word,
    .cta__copy p,
    .cta__actions,
    .cta__script,
    .cta__actions :global(.btn--primary),
    .cta__actions :global(.btn--primary .btn__icon) {
      transition: none;
    }

    .cta__actions :global(.btn--primary:hover),
    .cta__actions :global(.btn--primary:focus-visible),
    .cta__actions :global(.btn--primary:hover .btn__icon),
    .cta__actions :global(.btn--primary:focus-visible .btn__icon) {
      transform: none;
    }
  }
</style>
