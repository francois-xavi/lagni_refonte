---
/** Shared shell for the short utility pages: /merci/ and 404. */
import Icon from '../Icon.astro';
import LordIcon from '../LordIcon.astro';
import type { IconName } from '../Icon.astro';
import type { LordIconName } from '../LordIcon.astro';
import { href, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
  icon: IconName;
  code?: string;
  title: string;
  lead: string;
  listTitle?: string;
  list?: readonly string[];
  linksTitle?: string;
  links?: readonly { route: string; label: string }[];
}

const { lang, icon, code, title, lead, listTitle, list = [], linksTitle, links = [] } =
  Astro.props;

const lordFor: Partial<Record<IconName, LordIconName>> = { search: 'search', check: 'checklist' };
const lord = lordFor[icon];
---

<section class="simple">
  <div class="simple__plane" aria-hidden="true"></div>
  <div class="simple__plane simple__plane--accent" aria-hidden="true"></div>

  <div class="container simple__inner">
    <div class="simple__card" data-reveal="fade-up">
      <div class="simple__top">
        <span class="simple__icon" aria-hidden="true">
          {lord ? <LordIcon name={lord} size={40} trigger="in" /> : <Icon name={icon} size={30} />}
        </span>
        {code && <p class="simple__code">{code}</p>}
      </div>
      <h1>{title}</h1>
      <p class="simple__lead">{lead}</p>

      {
        list.length > 0 && (
          <div class="simple__block">
            {listTitle && <h2>{listTitle}</h2>}
            <ul class="simple__list">
              {list.map((item) => (
                <li>
                  <span class="simple__num" aria-hidden="true">
                    <Icon name="check" size={14} />
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        links.length > 0 && (
          <div class="simple__block">
            {linksTitle && <h2>{linksTitle}</h2>}
            <ul class="simple__links">
              {links.map((l) => (
                <li>
                  <a href={href(l.route, lang)}>
                    <span>{l.label}</span>
                    <span class="simple__arrow" aria-hidden="true">
                      <Icon name="arrow-right" size={15} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="simple__actions">
        <slot />
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/reveal';
  import '../../scripts/lordicon';
</script>

<style>
  .simple {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--s-16) var(--s-20);
    background:
      radial-gradient(ellipse 50% 60% at 0% 0%, rgba(255, 145, 77, 0.1), transparent 60%),
      radial-gradient(ellipse 60% 70% at 100% 100%, rgba(0, 74, 173, 0.12), transparent 60%),
      linear-gradient(180deg, var(--blue-050), var(--white));
  }

  .simple__plane {
    position: absolute;
    z-index: -1;
    top: 10%;
    right: -6rem;
    width: 22rem;
    height: 18rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--blue-100), var(--blue-050));
    transform: rotate(8deg);
    opacity: 0.8;
  }

  .simple__plane--accent {
    top: auto;
    right: auto;
    bottom: 8%;
    left: -5rem;
    width: 14rem;
    height: 11rem;
    background: linear-gradient(200deg, var(--orange-100), var(--orange-050));
    transform: rotate(-9deg);
  }

  .simple__inner {
    display: grid;
    justify-items: center;
  }

  .simple__card {
    position: relative;
    width: 100%;
    max-width: 44rem;
    padding: var(--s-8) var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 2px rgba(0, 46, 107, 0.04),
      0 24px 48px -24px rgba(0, 46, 107, 0.22);
    overflow: hidden;
  }

  .simple__card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--blue-700), var(--orange-500));
  }

  .simple__top {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }

  .simple__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    color: var(--blue-700);
    background: var(--blue-050);
    box-shadow: 0 0 0 8px rgba(232, 240, 251, 0.6);
  }

  .simple__code {
    font-family: var(--font-heading);
    font-size: var(--fs-4xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--orange-700);
  }

  .simple h1 {
    font-size: var(--fs-3xl);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--blue-900);
  }

  .simple__lead {
    margin-top: var(--s-4);
    font-size: var(--fs-md);
    color: var(--muted);
  }

  .simple__block {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }

  .simple__block h2 {
    margin-bottom: var(--s-4);
    font-size: var(--fs-md);
    color: var(--blue-900);
  }

  .simple__list {
    display: grid;
    gap: var(--s-3);
  }

  .simple__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    color: var(--ink-soft);
  }

  .simple__num {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 800;
    color: var(--orange-700);
    background: var(--orange-050);
    border-radius: 50%;
  }

  .simple__list li > span:last-child {
    padding-top: 0.3rem;
  }

  .simple__links {
    display: grid;
    gap: var(--s-2);
  }

  @media (min-width: 640px) {
    .simple__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .simple__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-3) var(--s-4);
    font-weight: 700;
    color: var(--blue-900);
    text-decoration: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s var(--ease-out);
  }

  .simple__links a:hover {
    border-color: var(--blue-200);
    background: var(--blue-050);
    transform: translateY(-2px);
  }

  .simple__arrow {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--blue-700);
    background: var(--blue-050);
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s var(--ease-out);
  }

  .simple__links a:hover .simple__arrow {
    color: var(--white);
    background: var(--orange-650);
    transform: translateX(3px);
  }

  .simple__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  .simple__actions:empty {
    display: none;
  }

  @media (min-width: 768px) {
    .simple__card {
      padding: var(--s-12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .simple__links a,
    .simple__arrow {
      transition: none;
    }

    .simple__links a:hover,
    .simple__links a:hover .simple__arrow {
      transform: none;
    }
  }
</style>
