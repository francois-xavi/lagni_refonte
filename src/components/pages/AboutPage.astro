---
/**
 * About page — composed from the shared section components.
 * Only the markets + ecosystems band keeps page-level markup.
 */
import ArtHero from '../sections/ArtHero.astro';
import ProofBand from '../sections/ProofBand.astro';
import NumberedCards from '../sections/NumberedCards.astro';
import FeaturedCard from '../sections/FeaturedCard.astro';
import FounderSplit from '../sections/FounderSplit.astro';
import StepTimeline from '../sections/StepTimeline.astro';
import ProcessChain from '../sections/ProcessChain.astro';
import NoticeCard from '../sections/NoticeCard.astro';
import CtaBand from '../CtaBand.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import type { LordIconName } from '../LordIcon.astro';
import { href, type Lang } from '../../i18n/routes';
import { useTranslations, usePages } from '../../i18n/utils';
import { publicImage } from '../../lib/assets';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = usePages(lang).about;

const purposeLords: Record<string, LordIconName> = { cap: 'cap', gear: 'tools', people: 'mentor' };
const valueLords: Record<string, LordIconName> = {
  bulb: 'tools',
  gear: 'search',
  book: 'book',
  handshake: 'conversation',
};
const journeyLords: LordIconName[] = ['server', 'experience', 'design', 'network', 'conversation'];
---

<ArtHero
  id="about-hero-title"
  eyebrow={p.hero.eyebrow}
  title={p.hero.title}
  tagline={p.hero.tagline}
  lead={p.hero.lead}
  trustItems={p.hero.trustItems}
  image={{ src: '/assets/images/hero-about.webp', alt: p.hero.imageAlt, width: 900, height: 1100 }}
  valueCard={{ text: p.hero.quote, variant: 'script' }}
>
  <Button href={href('erp', lang)} variant="primary" size="lg">{p.hero.ctaPrimary}</Button>
  <Button href={href('contact', lang)} variant="ghost" size="lg">{p.hero.ctaSecondary}</Button>
</ArtHero>

<ProofBand
  label={p.proof.label}
  items={p.proof.items.map((item) => ({ ...item, lord: item.lord as LordIconName }))}
/>

<NumberedCards
  id="purp-title"
  eyebrow={p.purpose.eyebrow}
  title={p.purpose.title}
  lead={p.purpose.tagline}
  items={p.purpose.items.map((i) => ({ title: i.title, body: i.body, lord: purposeLords[i.icon] ?? 'cap' }))}
  quote={p.purpose.quote}
  reveal
/>

<FeaturedCard
  id="story-title"
  badge={p.story.eyebrow}
  title={p.story.tagline}
  body={`${p.story.body[0]} ${p.story.body[1]}`}
  topics={p.story.chain.map((c) => c.title)}
  image={{
    src: publicImage('about-story.webp'),
    alt: p.story.imageAlt,
    slot: 'about-story',
    width: 1000,
    height: 800,
    fallbackIcon: 'layers',
  }}
>
  <div slot="note" class="storyNote">
    <p>{p.story.body[2]}</p>
    <p class="storyNote__chain">{p.story.chainTitle}</p>
  </div>
</FeaturedCard>

<FounderSplit
  id="found-title"
  eyebrow={p.founderSection.title}
  title={p.founderSection.tagline}
  body={p.founderSection.body[0]}
  image={{ src: '/assets/images/founder.jpg', alt: t.founder.photoAlt, slot: 'founder-portrait' }}
  points={p.founderSection.points}
  signature={{ name: t.founder.name, role: t.founder.role }}
  link={{ href: href('contact', lang), label: p.hero.ctaSecondary }}
/>

<NumberedCards
  id="values-title"
  eyebrow={p.values.eyebrow}
  title={p.values.title}
  lead={p.values.lead}
  items={p.values.items.map((i) => ({ title: i.title, body: i.body, lord: valueLords[i.icon] ?? 'book' }))}
  reveal
/>

<StepTimeline
  id="journey-title"
  eyebrow={p.journey.eyebrow}
  title={p.journey.title}
  lead={p.journey.tagline}
  steps={p.journey.items.map((j, i) => ({ title: j.name, body: j.body, lord: journeyLords[i] ?? 'server' }))}
  tint
>
  <p class="softNote">{p.journey.note}</p>
</StepTimeline>

<ProcessChain
  id="spec-title"
  eyebrow={p.specialisation.eyebrow}
  title={p.specialisation.title}
  lead={`${p.specialisation.tagline} ${p.specialisation.body}`}
  steps={p.specialisation.chain}
  systems={p.specialisation.systems}
/>

<section class="section section--tint mkt" aria-labelledby="mkt-title">
  <div class="container mkt__grid">
    <div data-reveal="fade-up">
      <p class="eyebrow mkt__eyebrow">{p.markets.eyebrow}</p>
      <h2 id="mkt-title">{p.markets.title}</h2>
      <p class="mkt__tagline">{p.markets.tagline}</p>
      {p.markets.body.map((para) => <p class="mkt__body">{para}</p>)}
      <ul class="mkt__list" data-reveal="stagger">
        {
          p.markets.items.map((m, i) => (
            <li style={`--i:${i + 1}`}>
              <Icon name="pin" size={18} />
              <span>{m}</span>
            </li>
          ))
        }
      </ul>
      <p class="softNote">{p.markets.note}</p>
    </div>
    <div class="eco" data-reveal="fade-up">
      <h3 class="eco__title">{t.ecosystems.title}</h3>
      <p class="eco__sub">{t.ecosystems.subtitle}</p>
      <ul class="eco__list">
        {t.ecosystems.items.map((e) => <li>{e}</li>)}
      </ul>
      <NoticeCard lord="shield" body={p.ecosystemNote} tone="info" />
    </div>
  </div>
</section>

<CtaBand title={p.finalCta.title} body={p.finalCta.body} script={p.finalCta.script} imageSlot="cta-about">
  <Button href={href('contact', lang)} variant="primary" size="lg">{p.finalCta.cta}</Button>
</CtaBand>

<script>
  import '../../scripts/reveal';
  import '../../scripts/lordicon';
</script>

<style>
  .softNote {
    font-size: var(--fs-sm);
    font-style: italic;
    color: var(--muted);
    max-width: 70ch;
  }

  .storyNote {
    display: grid;
    gap: var(--s-3);
    color: var(--muted);
  }

  .storyNote__chain {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--blue-900);
  }

  /* ── Markets + ecosystems ── */

  .mkt__grid {
    display: grid;
    gap: var(--s-10);
    align-items: start;
  }

  .mkt__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }

  .mkt__eyebrow::before {
    content: '';
    width: 1.75rem;
    height: 2px;
    background: var(--orange-500);
    border-radius: 2px;
  }

  .mkt h2 {
    font-size: var(--fs-3xl);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--blue-900);
  }

  .mkt__tagline {
    margin-top: var(--s-3);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--orange-700);
  }

  .mkt__body {
    margin-top: var(--s-4);
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .mkt__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin: var(--s-6) 0 var(--s-4);
  }

  .mkt__list li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.55rem 1rem;
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--blue-900);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }

  .mkt__list :global(svg) {
    color: var(--orange-700);
  }

  .eco {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px -14px rgba(0, 46, 107, 0.16);
  }

  .eco__title {
    font-size: var(--fs-xl);
    color: var(--blue-900);
  }

  .eco__sub {
    margin-top: calc(var(--s-3) * -1);
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .eco__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .eco__list li {
    padding: 0.45rem 0.9rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--blue-800);
    background: var(--blue-050);
    border: 1px solid var(--blue-100);
    border-radius: var(--radius-pill);
  }

  @media (min-width: 1000px) {
    .mkt__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--s-16);
    }

    .eco {
      padding: var(--s-8);
    }
  }
</style>
