---
/**
 * Legal text page. Deliberately plain: no animated icons, no decorative
 * sections — it has to be readable and printable.
 */
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import NoticeCard from '../sections/NoticeCard.astro';
import { href, type Lang } from '../../i18n/routes';
import { usePages } from '../../i18n/utils';
import { CONTACT } from '../../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = usePages(lang).privacy;
---

<section class="legalHero">
  <div class="container legalHero__inner">
    <p class="eyebrow">{p.hero.eyebrow}</p>
    <h1>{p.hero.title}</h1>
    <p class="legalHero__lead">{p.hero.lead}</p>
    <p class="legalHero__updated">
      <Icon name="calendar" size={15} />
      <span>{p.hero.updated} : {p.hero.updatedDate}</span>
    </p>
  </div>
</section>

<section class="section legal">
  <div class="container legal__inner">
    {/* Remove this notice once Lagni Consulting has approved the wording. */}
    <NoticeCard lord="shield" body={p.draftNotice} />

    <nav class="toc" aria-labelledby="toc-title">
      <p class="toc__title" id="toc-title">Sommaire</p>
      <ol>
        {
          p.sections.map((s, i) => (
            <li>
              <a href={`#sec-${i + 1}`}>{s.title}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      p.sections.map((s, i) => (
        <section class="legal__block" aria-labelledby={`sec-${i + 1}`}>
          <h2 id={`sec-${i + 1}`}>
            <span class="legal__num" aria-hidden="true">{i + 1}</span>
            {s.title}
          </h2>

          {'body' in s && s.body?.map((para) => <p>{para}</p>)}

          {'items' in s && s.items && (
            <ul class="legal__list">
              {s.items.map((item) => (
                <li>
                  <Icon name="check" size={15} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}

          {'note' in s && s.note && <p class="legal__note">{s.note}</p>}
        </section>
      ))
    }

    <section class="legal__contact" aria-labelledby="legal-contact">
      <h2 id="legal-contact">{p.contact.title}</h2>
      <p>{p.contact.body}</p>
      <ul class="legal__coords">
        <li>
          <Icon name="mail" size={17} />
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </li>
        <li>
          <Icon name="pin" size={17} />
          <span>{CONTACT.locality}</span>
        </li>
      </ul>
      <Button href={href('contact', lang)} variant="primary">{p.contact.cta}</Button>
    </section>
  </div>
</section>

<style>
  .legalHero {
    padding-block: var(--s-12) var(--s-10);
    background: linear-gradient(180deg, var(--blue-050), var(--white));
    border-bottom: 1px solid var(--line);
  }

  .legalHero__inner {
    max-width: 48rem;
  }

  .legalHero h1 {
    font-size: var(--fs-3xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--blue-900);
  }

  .legalHero__lead {
    margin-top: var(--s-4);
    font-size: var(--fs-md);
    color: var(--muted);
  }

  .legalHero__updated {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-6);
    padding: 0.35rem 0.8rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--blue-700);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }

  .legal__inner {
    max-width: 48rem;
  }

  /* ── Table of contents ── */

  .toc {
    margin-block: var(--s-8);
    padding: var(--s-5) var(--s-6);
    background: var(--blue-050);
    border: 1px solid var(--blue-100);
    border-radius: var(--radius-lg);
  }

  .toc__title {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--s-3);
  }

  .toc ol {
    display: grid;
    gap: var(--s-2);
    counter-reset: toc;
    list-style: none;
  }

  .toc li {
    counter-increment: toc;
  }

  .toc a {
    display: flex;
    gap: var(--s-3);
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--blue-900);
    text-decoration: none;
  }

  .toc a::before {
    content: counter(toc) '.';
    flex-shrink: 0;
    font-weight: 700;
    color: var(--orange-700);
  }

  .toc a:hover {
    color: var(--blue-700);
    text-decoration: underline;
  }

  /* ── Sections ── */

  .legal__block {
    margin-top: var(--s-10);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .legal__block h2 {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
    font-size: var(--fs-xl);
    color: var(--blue-900);
  }

  .legal__num {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-size: var(--fs-sm);
    font-weight: 800;
    color: var(--white);
    background: var(--blue-700);
    border-radius: 50%;
  }

  .legal__block p {
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .legal__block p + p {
    margin-top: var(--s-3);
  }

  .legal__list {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .legal__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .legal__list :global(svg) {
    flex-shrink: 0;
    margin-top: 5px;
    color: var(--blue-600);
  }

  .legal__note {
    margin-top: var(--s-4);
    padding: var(--s-3) var(--s-4);
    font-size: var(--fs-base);
    background: var(--orange-050);
    border-left: 3px solid var(--orange-500);
    border-radius: var(--radius-sm);
  }

  /* ── Contact ── */

  .legal__contact {
    margin-top: var(--s-12);
    padding: var(--s-6);
    background: var(--blue-050);
    border: 1px solid var(--blue-100);
    border-radius: var(--radius-lg);
  }

  .legal__contact h2 {
    font-size: var(--fs-lg);
    color: var(--blue-900);
    margin-bottom: var(--s-3);
  }

  .legal__coords {
    display: grid;
    gap: var(--s-2);
    margin-block: var(--s-4);
  }

  .legal__coords li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink-soft);
  }

  .legal__coords :global(svg) {
    color: var(--blue-700);
  }

  .legal__coords a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .legal__coords a:hover {
    color: var(--blue-700);
    text-decoration: underline;
  }

  @media print {
    .toc,
    .legal__contact :global(.btn) {
      display: none;
    }
  }
</style>
