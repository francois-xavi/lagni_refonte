---
/**
 * Art-directed hero: copy on the left, a photo stage with three floating
 * glass cards on the right. Shared by every page hero on the site.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';

interface Props {
  id: string;
  eyebrow?: string;
  /** Line breaks (`\n`) are kept as <br>. */
  title: string;
  tagline?: string;
  lead: string;
  trustItems: readonly { icon: string; label: string }[];
  image: { src: string; alt: string; width: number; height: number };
  matchCard?: { label: string; title: string; pills: readonly string[] };
  profileCard?: { badge: string; label: string; title: string; status?: string };
  /** Bottom card. `script` renders it in the handwritten accent face. */
  valueCard?: { text: string; variant?: 'heading' | 'script' };
  /** Shorter band for utility pages (contact, resources). */
  compact?: boolean;
}

const {
  id,
  eyebrow,
  title,
  tagline,
  lead,
  trustItems,
  image,
  matchCard,
  profileCard,
  valueCard,
  compact = false,
} = Astro.props;

const titleLines = title.split('\n');
const valueLines = valueCard ? valueCard.text.split('\n') : [];
---

<section class:list={['art-hero', compact && 'art-hero--compact']} aria-labelledby={id}>
  <div class="container art-hero__grid">
    <div class="art-hero__copy">
      {eyebrow && <p class="art-hero__eyebrow">{eyebrow}</p>}
      <h1 id={id} class="art-hero__title">
        {
          titleLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              <span>{line}</span>
            </>
          ))
        }
      </h1>
      {tagline && <p class="art-hero__tagline">{tagline}</p>}
      <p class="art-hero__lead">{lead}</p>

      <div class="art-hero__actions">
        <slot />
      </div>

      <ul class="art-hero__trust">
        {
          trustItems.map((item) => (
            <li class="art-hero__tag">
              <span class="art-hero__tagIcon" aria-hidden="true">
                <Icon name={item.icon as IconName} size={14} />
              </span>
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="art-hero__stage">
      <div class="art-hero__plane" aria-hidden="true"></div>
      <div class="art-hero__plane art-hero__plane--accent" aria-hidden="true"></div>

      <div class="art-hero__visual">
        <img
          class="art-hero__img"
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="eager"
          decoding="async"
        />
      </div>

      {
        matchCard && (
          <aside class="art-hero__card art-hero__card--match">
            <p class="art-hero__cardLabel">{matchCard.label}</p>
            <p class="art-hero__cardTitle">{matchCard.title}</p>
            <ul class="art-hero__pills">
              {matchCard.pills.map((pill) => (
                <li>{pill}</li>
              ))}
            </ul>
          </aside>
        )
      }

      {
        profileCard && (
          <aside class="art-hero__card art-hero__card--profile">
            <span class="art-hero__initials" aria-hidden="true">
              {profileCard.badge}
            </span>
            <div>
              <p class="art-hero__cardLabel">{profileCard.label}</p>
              <p class="art-hero__cardTitle">{profileCard.title}</p>
              {profileCard.status && <p class="art-hero__status">{profileCard.status}</p>}
            </div>
          </aside>
        )
      }

      {
        valueCard && (
          <aside class="art-hero__card art-hero__card--value">
            <p class:list={['art-hero__value', valueCard.variant === 'script' && 'art-hero__value--script']}>
              {valueLines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          </aside>
        )
      }
    </div>
  </div>
</section>

<style>
  .art-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 100% 0%, rgba(199, 219, 244, 0.78), transparent 58%),
      radial-gradient(ellipse 48% 42% at 0% 12%, rgba(255, 232, 217, 0.62), transparent 52%),
      radial-gradient(ellipse 40% 35% at 55% 100%, rgba(232, 240, 251, 0.55), transparent 60%),
      linear-gradient(180deg, #f5f8fc 0%, #fafbfd 48%, var(--bg) 100%);
    padding-block: var(--s-12) var(--s-12);
  }

  .art-hero__grid {
    display: grid;
    gap: var(--s-10);
    align-items: center;
  }

  .art-hero__title {
    font-size: clamp(1.95rem, 1.35rem + 2.5vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 700;
    color: var(--blue-700);
    max-width: 13ch;
  }

  .art-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--orange-700);
  }

  .art-hero__eyebrow::before {
    content: '';
    width: 1.75rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--orange-500);
  }

  .art-hero__tagline {
    margin-top: var(--s-5);
    max-width: 34rem;
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.4;
    color: var(--blue-900);
  }

  .art-hero__tagline + .art-hero__lead {
    margin-top: var(--s-4);
  }

  .art-hero__lead {
    margin-top: var(--s-7);
    font-size: var(--fs-md);
    color: var(--muted);
    max-width: 34rem;
    line-height: 1.72;
  }

  .art-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin-top: 2.4rem;
  }

  /* Scoped CTA polish — does not change global Button.astro */
  .art-hero__actions :global(.btn--primary) {
    padding: 1.05rem 1.85rem;
    font-size: 1.02rem;
    border-radius: var(--radius-pill);
    box-shadow:
      0 12px 32px rgba(255, 145, 77, 0.38),
      0 3px 8px rgba(0, 46, 107, 0.1);
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease,
      background-color 0.18s ease;
  }

  .art-hero__actions :global(.btn--primary:hover) {
    transform: translateY(-3px);
    box-shadow:
      0 18px 40px rgba(255, 145, 77, 0.45),
      0 6px 14px rgba(0, 46, 107, 0.12);
  }

  .art-hero__actions :global(.btn--ghost) {
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .art-hero__actions :global(.btn--ghost:hover) {
    color: var(--blue-700);
    text-decoration: none;
  }

  .art-hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.15rem;
    row-gap: 0.65rem;
    margin-top: 2.85rem;
    padding-top: var(--s-7);
    border-top: 1px solid rgba(0, 74, 173, 0.1);
    list-style: none;
    max-width: 42rem;
  }

  .art-hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.015em;
    color: var(--blue-700);
    line-height: 1.3;
    white-space: nowrap;
  }

  .art-hero__tagIcon {
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: rgba(232, 240, 251, 0.95);
    box-shadow: 0 1px 3px rgba(0, 46, 107, 0.06);
    color: var(--blue-700);
    flex-shrink: 0;
  }

  /* ── Stage ── */
  .art-hero__stage {
    position: relative;
    min-height: 30rem;
  }

  .art-hero__plane {
    position: absolute;
    z-index: 0;
    border-radius: 32% 68% 48% 52%;
    background: linear-gradient(160deg, var(--blue-100), var(--blue-050));
    width: 82%;
    height: 76%;
    right: -4%;
    top: 6%;
    transform: rotate(7deg);
    opacity: 0.9;
  }

  .art-hero__plane--accent {
    width: 44%;
    height: 36%;
    left: -6%;
    bottom: 10%;
    top: auto;
    right: auto;
    background: linear-gradient(200deg, var(--orange-100), var(--orange-050));
    border-radius: 48% 52% 40% 60%;
    transform: rotate(-8deg);
    opacity: 0.85;
  }

  .art-hero__visual {
    position: absolute;
    inset: 0.85rem 0.35rem 3.25rem 1.75rem;
    z-index: 1;
    border-radius: 1.65rem;
    overflow: hidden;
    box-shadow:
      0 28px 64px rgba(0, 46, 107, 0.18),
      0 10px 24px rgba(0, 46, 107, 0.09);
    background: var(--blue-200);
    animation: homeHeroVisualIn 0.9s ease both;
  }

  .art-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    display: block;
  }

  /* Soft left scrim + bottom fade — anchors composition toward copy */
  .art-hero__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgba(0, 46, 107, 0.48) 0%,
        rgba(0, 46, 107, 0.22) 26%,
        rgba(0, 46, 107, 0.06) 42%,
        transparent 58%
      ),
      linear-gradient(180deg, transparent 52%, rgba(0, 46, 107, 0.36) 100%);
    pointer-events: none;
  }

  .art-hero__card {
    position: absolute;
    z-index: 3;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
      0 22px 48px rgba(0, 46, 107, 0.14),
      0 6px 16px rgba(0, 46, 107, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(18px) saturate(1.15);
    -webkit-backdrop-filter: blur(18px) saturate(1.15);
    opacity: 0;
    will-change: transform, opacity;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .art-hero__card:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.88);
    box-shadow:
      0 28px 56px rgba(0, 46, 107, 0.18),
      0 8px 20px rgba(0, 46, 107, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .art-hero__card--match {
    top: 1.1rem;
    left: 0;
    width: 11.75rem;
    border-radius: var(--radius-lg);
    padding: var(--s-3) var(--s-3);
    animation: homeCardInLeft 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }

  .art-hero__card--profile {
    right: 0;
    top: 40%;
    width: 12.5rem;
    border-radius: var(--radius-lg);
    padding: var(--s-3);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-2);
    align-items: center;
    animation: homeCardInRight 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
  }

  .art-hero__card--value {
    left: 6%;
    bottom: 0.35rem;
    width: 12.5rem;
    border-radius: var(--radius-lg);
    padding: var(--s-4);
    background: linear-gradient(160deg, rgba(0, 58, 135, 0.94), rgba(0, 46, 107, 0.97));
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--white);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    box-shadow:
      0 24px 48px rgba(0, 46, 107, 0.32),
      0 0 0 1px rgba(255, 145, 77, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    animation: homeCardInUp 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
  }

  .art-hero__card--value:hover {
    transform: translateY(-6px);
    background: linear-gradient(160deg, rgba(0, 58, 135, 0.98), rgba(0, 46, 107, 1));
    box-shadow:
      0 28px 56px rgba(0, 46, 107, 0.38),
      0 0 0 1px rgba(255, 145, 77, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .art-hero__card--value::before {
    content: '';
    display: block;
    width: 1.5rem;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--orange-500);
    margin-bottom: var(--s-2);
  }

  .art-hero__cardLabel {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange-700);
    margin-bottom: 0.25rem;
  }

  .art-hero__card--profile .art-hero__cardLabel {
    color: var(--muted);
  }

  .art-hero__cardTitle {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--blue-700);
    line-height: var(--lh-snug);
  }

  .art-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: var(--s-2);
  }

  .art-hero__pills li {
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--blue-700);
    background: rgba(232, 240, 251, 0.9);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-pill);
  }

  .art-hero__initials {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: rgba(232, 240, 251, 0.95);
    color: var(--blue-700);
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .art-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--success);
  }

  .art-hero__status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px var(--success-bg);
  }

  .art-hero__value {
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: var(--lh-snug);
    letter-spacing: -0.02em;
  }

  .art-hero__value--script {
    font-family: var(--font-script);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
  }

  /* Copy cascade: eyebrow → title → tagline → lead → actions → trust tags. */
  .art-hero__copy > * {
    animation: artHeroCopyIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .art-hero__copy > :nth-child(2) {
    animation-delay: 0.08s;
  }

  .art-hero__copy > :nth-child(3) {
    animation-delay: 0.16s;
  }

  .art-hero__copy > :nth-child(4) {
    animation-delay: 0.24s;
  }

  .art-hero__copy > :nth-child(5) {
    animation-delay: 0.32s;
  }

  .art-hero__copy > :nth-child(6) {
    animation-delay: 0.4s;
  }

  @keyframes artHeroCopyIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes homeHeroVisualIn {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes homeCardInLeft {
    from {
      opacity: 0;
      transform: translateX(-22px) translateY(8px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateX(0) translateY(0) scale(1);
    }
  }

  @keyframes homeCardInRight {
    from {
      opacity: 0;
      transform: translateX(22px) translateY(8px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateX(0) translateY(0) scale(1);
    }
  }

  @keyframes homeCardInUp {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (min-width: 900px) {
    .art-hero {
      padding-block: var(--s-20) var(--s-16);
    }

    .art-hero__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--s-12);
    }

    .art-hero__copy {
      padding-block: var(--s-6);
    }

    .art-hero__title {
      line-height: 1.04;
      letter-spacing: -0.042em;
    }

    .art-hero__lead {
      margin-top: var(--s-8);
    }

    .art-hero__actions {
      margin-top: var(--s-10);
    }

    .art-hero__trust {
      margin-top: var(--s-12);
      padding-top: var(--s-8);
      column-gap: 1.35rem;
    }

    .art-hero__stage {
      min-height: 38rem;
    }
  }

  @media (min-width: 1200px) {
    .art-hero__title {
      max-width: 13ch;
      font-size: clamp(2.4rem, 1.6rem + 1.4vw, 3.15rem);
    }

    .art-hero__stage {
      min-height: 40rem;
    }

    .art-hero__visual {
      inset: 0.75rem 0.25rem 3.5rem 2rem;
      border-radius: 1.85rem;
    }
  }

  @media (max-width: 899px) {
    .art-hero__title {
      max-width: none;
    }

    .art-hero__stage {
      max-width: 30rem;
      margin-inline: auto;
      width: 100%;
      min-height: 28rem;
    }

    .art-hero__visual {
      inset: 1.25rem 0.5rem 3.75rem 1.15rem;
    }

    .art-hero__card--match {
      width: 10.25rem;
      top: 0.5rem;
    }

    .art-hero__card--profile {
      width: 11rem;
    }

    .art-hero__card--value {
      width: 11rem;
      left: 3%;
    }
  }

  @media (max-width: 420px) {
    .art-hero__stage {
      min-height: 25rem;
    }

    .art-hero__card--match {
      display: none;
    }

    .art-hero__card--profile {
      width: 10.5rem;
      top: auto;
      bottom: 5rem;
      right: 0.15rem;
    }

    .art-hero__card--value {
      width: 10.5rem;
    }
  }

  /* ── Compact variant ── */
  .art-hero--compact .art-hero__stage {
    min-height: 22rem;
  }

  .art-hero--compact .art-hero__trust {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
  }

  @media (min-width: 900px) {
    .art-hero--compact {
      padding-block: var(--s-16) var(--s-12);
    }

    .art-hero--compact .art-hero__stage {
      min-height: 28rem;
    }

    .art-hero--compact .art-hero__actions {
      margin-top: var(--s-8);
    }

    .art-hero--compact .art-hero__trust {
      margin-top: var(--s-10);
      padding-top: var(--s-6);
    }
  }

  @media (max-width: 420px) {
    .art-hero--compact .art-hero__stage {
      min-height: 20rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-hero__visual,
    .art-hero__card,
    .art-hero__copy > * {
      animation: none;
      opacity: 1;
    }

    .art-hero__card,
    .art-hero__actions :global(.btn--primary) {
      transition: none;
    }

    .art-hero__card:hover,
    .art-hero__actions :global(.btn--primary:hover) {
      transform: none;
    }
  }
</style>
