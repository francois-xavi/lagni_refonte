---
/**
 * Page hero: the offer in plain words on the left, one photo with a single
 * value card on the right. Shared by every page hero on the site.
 * Kept deliberately calm — one entrance fade, no floating UI chrome — so the
 * headline and the next step are the first things a visitor reads.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import { withBase } from '../../lib/url';

interface Props {
  id: string;
  eyebrow?: string;
  /** Line breaks (`\n`) are kept as <br>. */
  title: string;
  tagline?: string;
  lead: string;
  trustItems: readonly { icon: string; label: string }[];
  image: { src: string; alt: string; width: number; height: number };
  /** Bottom card. `script` renders it in the handwritten accent face. */
  valueCard?: { text: string; variant?: 'heading' | 'script' };
  /** Shorter band for utility pages (contact, resources). */
  compact?: boolean;
}

const {
  id,
  eyebrow,
  title,
  tagline,
  lead,
  trustItems,
  image,
  valueCard,
  compact = false,
} = Astro.props;

const titleLines = title.split('\n');
const valueLines = valueCard ? valueCard.text.split('\n') : [];
---

<section class:list={['art-hero', compact && 'art-hero--compact']} aria-labelledby={id}>
  <div class="container art-hero__grid">
    <div class="art-hero__copy">
      {eyebrow && <p class="art-hero__eyebrow">{eyebrow}</p>}
      <h1 id={id} class="art-hero__title">
        {
          titleLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              <span>{line}</span>
            </>
          ))
        }
      </h1>
      {tagline && <p class="art-hero__tagline">{tagline}</p>}
      <p class="art-hero__lead">{lead}</p>

      <div class="art-hero__actions">
        <slot />
      </div>

      <ul class="art-hero__trust">
        {
          trustItems.map((item) => (
            <li class="art-hero__tag">
              <span class="art-hero__tagIcon" aria-hidden="true">
                <Icon name={item.icon as IconName} size={14} />
              </span>
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="art-hero__stage">
      <div class="art-hero__plane" aria-hidden="true"></div>

      <div class="art-hero__visual">
        <img
          class="art-hero__img"
          src={withBase(image.src)}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="eager"
          decoding="async"
        />
      </div>

      {
        valueCard && (
          <aside class="art-hero__card art-hero__card--value">
            <p class:list={['art-hero__value', valueCard.variant === 'script' && 'art-hero__value--script']}>
              {valueLines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          </aside>
        )
      }
    </div>
  </div>
</section>

<style>
  .art-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 100% 0%, rgba(199, 219, 244, 0.6), transparent 58%),
      radial-gradient(ellipse 48% 42% at 0% 12%, rgba(255, 232, 217, 0.45), transparent 52%),
      linear-gradient(180deg, #f5f8fc 0%, var(--bg) 100%);
    padding-block: var(--s-10) var(--s-12);
  }

  .art-hero__grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }

  .art-hero__copy {
    animation: artHeroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .art-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange-700);
  }

  .art-hero__eyebrow::before {
    content: '';
    width: 1.5rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--orange-500);
  }

  .art-hero__title {
    font-size: var(--fs-display);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--blue-900);
    max-width: 20ch;
    text-wrap: balance;
  }

  .art-hero__tagline {
    margin-top: var(--s-5);
    max-width: 34rem;
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--blue-800);
  }

  .art-hero__lead {
    margin-top: var(--s-5);
    font-size: var(--fs-lg);
    color: var(--muted);
    max-width: 36rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .art-hero__tagline + .art-hero__lead {
    margin-top: var(--s-3);
  }

  .art-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-8);
  }

  /* Scoped CTA polish — does not change global Button.astro */
  .art-hero__actions :global(.btn--primary) {
    padding: 0.95rem 1.6rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 20px rgba(184, 90, 31, 0.22);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.18s ease;
  }

  .art-hero__actions :global(.btn--primary:hover) {
    transform: translateY(-1px);
    box-shadow: 0 12px 26px rgba(184, 90, 31, 0.28);
  }

  .art-hero__actions :global(.btn--ghost) {
    color: var(--blue-700);
    font-weight: 600;
    text-decoration: none;
  }

  .art-hero__actions :global(.btn--ghost:hover) {
    color: var(--blue-900);
    text-decoration: none;
  }

  .art-hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid rgba(0, 74, 173, 0.1);
    list-style: none;
    max-width: 40rem;
  }

  .art-hero__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }

  .art-hero__tagIcon {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--blue-050);
    color: var(--blue-700);
    flex-shrink: 0;
  }

  /* ── Stage ── */
  .art-hero__stage {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .art-hero__plane {
    position: absolute;
    z-index: 0;
    border-radius: 32% 68% 48% 52%;
    background: linear-gradient(160deg, var(--blue-100), var(--blue-050));
    width: 82%;
    height: 76%;
    right: -4%;
    top: 6%;
    transform: rotate(7deg);
    opacity: 0.8;
  }

  .art-hero__visual {
    position: absolute;
    inset: 0 0 var(--s-8) 0;
    z-index: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 56px rgba(0, 46, 107, 0.16);
    background: var(--blue-200);
  }

  .art-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    display: block;
  }

  .art-hero__card {
    position: absolute;
    z-index: 3;
  }

  .art-hero__card--value {
    left: var(--s-4);
    bottom: 0;
    max-width: 15rem;
    border-radius: var(--radius-lg);
    padding: var(--s-4) var(--s-5);
    background: var(--blue-800);
    color: var(--white);
    box-shadow: 0 16px 36px rgba(0, 46, 107, 0.28);
  }

  .art-hero__card--value::before {
    content: '';
    display: block;
    width: 1.5rem;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--orange-500);
    margin-bottom: var(--s-2);
  }

  .art-hero__value {
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: var(--lh-snug);
    letter-spacing: -0.01em;
  }

  .art-hero__value--script {
    font-family: var(--font-script);
    font-size: var(--fs-xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
  }

  @keyframes artHeroIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 900px) {
    .art-hero {
      padding-block: var(--s-20) var(--s-20);
    }

    .art-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--s-16);
    }

    .art-hero__stage {
      aspect-ratio: 4 / 5;
      max-height: 38rem;
    }

    .art-hero__visual {
      inset: 0 0 var(--s-10) var(--s-8);
    }

    .art-hero__card--value {
      left: 0;
    }
  }

  @media (max-width: 899px) {
    .art-hero__stage {
      max-width: 34rem;
      width: 100%;
    }
  }

  /* ── Compact variant (utility pages) ── */
  @media (min-width: 900px) {
    .art-hero--compact {
      padding-block: var(--s-16);
    }

    .art-hero--compact .art-hero__stage {
      aspect-ratio: 1 / 1;
      max-height: 28rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-hero__copy {
      animation: none;
    }

    .art-hero__actions :global(.btn--primary),
    .art-hero__actions :global(.btn--primary:hover) {
      transition: none;
      transform: none;
    }
  }
</style>
