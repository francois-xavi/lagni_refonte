---
/**
 * Intro + pull quote on one side, anonymised experience cards on the other
 * (ERP cases). The disclaimer is always rendered under the cards.
 */
import Icon from '../Icon.astro';
import LordIcon from '../LordIcon.astro';
import type { LordIconName } from '../LordIcon.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead: string;
  quote?: string;
  items: readonly {
    title: string;
    subtitle: string;
    tags: readonly string[];
    lord: LordIconName;
  }[];
  disclaimer: string;
}

const { id, eyebrow, title, lead, quote, items, disclaimer } = Astro.props;
---

<section class="section section--tint" aria-labelledby={id}>
  <div class="container cases">
    <div class="cases__intro" data-reveal="fade-up">
      <p class="eyebrow cases__eyebrow">{eyebrow}</p>
      <h2 id={id}>{title}</h2>
      <p class="lead">{lead}</p>
      {
        quote && (
          <blockquote class="cases__quote">
            <Icon name="quote" size={28} />
            <p>{quote}</p>
          </blockquote>
        )
      }
    </div>

    <div>
      <ol class="cases__list" data-reveal="stagger">
        {
          items.map((c, i) => (
            <li style={`--i:${i + 1}`}>
              <article class="case">
                <div class="case__head">
                  <span class="case__icon">
                    <LordIcon name={c.lord} size={30} target=".case" />
                  </span>
                  <div>
                    <h3>{c.title}</h3>
                    <p class="case__system">{c.subtitle}</p>
                  </div>
                  <span class="case__num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                </div>
                <ul class="case__tags">
                  {c.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
      <p class="cases__disclaimer">
        <Icon name="lock" size={16} />
        <span>{disclaimer}</span>
      </p>
    </div>
  </div>
</section>

<script>
  import '../../scripts/reveal';
  import '../../scripts/lordicon';
</script>

<style>
  .cases {
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-10);
  }

  .cases__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    letter-spacing: 0.14em;
    margin-bottom: var(--s-4);
  }

  .cases__eyebrow::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--orange-500);
  }

  .cases h2 {
    font-size: var(--fs-4xl);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--blue-900);
  }

  .cases__intro .lead {
    margin-top: var(--s-5);
    max-width: 44ch;
  }

  .cases__quote {
    margin-top: var(--s-8);
    padding: var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 3px solid var(--orange-500);
    border-radius: var(--radius);
  }

  .cases__quote :global(svg) {
    color: var(--blue-200);
    margin-bottom: var(--s-2);
  }

  .cases__quote p {
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--blue-800);
  }

  .cases__list {
    display: grid;
    gap: var(--s-5);
  }

  .case {
    padding: var(--s-6);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out);
  }

  .case:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 74, 173, 0.22);
    box-shadow: var(--shadow-md);
  }

  .case__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-4);
  }

  .case__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: var(--blue-050);
    border: 1px solid rgba(0, 74, 173, 0.08);
  }

  .case h3 {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.25;
    color: var(--blue-900);
  }

  .case__system {
    margin-top: var(--s-1);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--orange-700);
  }

  .case__num {
    align-self: start;
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--orange-700);
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .case__tags li {
    padding: 0.25rem 0.7rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--blue-700);
    background: var(--blue-050);
    border: 1px solid rgba(0, 74, 173, 0.1);
    border-radius: var(--radius-pill);
  }

  .cases__disclaimer {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
    margin-top: var(--s-6);
    font-size: var(--fs-sm);
    font-style: italic;
    line-height: 1.6;
    color: var(--muted);
  }

  .cases__disclaimer :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--blue-700);
  }

  @media (min-width: 900px) {
    .cases {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--s-16);
      align-items: start;
    }

    .cases__intro {
      position: sticky;
      top: calc(var(--header-h, 72px) + var(--s-8));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case {
      transition: none;
    }

    .case:hover {
      transform: none;
    }
  }
</style>
