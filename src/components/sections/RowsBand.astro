---
/**
 * Dark editorial band: sticky intro on the left, numbered link rows on the
 * right (homepage Companies, Formations pathways).
 * Slots: default (intro actions), `after` (fine print under the rows).
 */
import Icon from '../Icon.astro';
import LordIcon from '../LordIcon.astro';
import type { LordIconName } from '../LordIcon.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  rows: readonly {
    title: string;
    subtitle?: string;
    desc: string;
    href: string;
    lord: LordIconName;
    pills?: readonly string[];
  }[];
}

const { id, eyebrow, title, body, rows } = Astro.props;
const hasActions = Astro.slots.has('default');
const hasAfter = Astro.slots.has('after');
---

<section class="section corp" aria-labelledby={id}>
  <div class="container corp__inner">
    <div class="corp__intro" data-reveal="fade-up">
      <p class="eyebrow eyebrow--onDark corp__eyebrow">{eyebrow}</p>
      <h2 id={id}>{title}</h2>
      <p class="corp__body">{body}</p>
      {
        hasActions && (
          <div class="corp__actions">
            <slot />
          </div>
        )
      }
    </div>
    <div>
      <ol class="corp__rows" data-reveal="stagger">
        {
          rows.map((row, i) => (
            <li style={`--i:${i + 1}`}>
              <a class="corp__row" href={row.href}>
                <span class="corp__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="corp__icon">
                  <LordIcon name={row.lord} size={30} tone="light" target=".corp__row" />
                </span>
                <div class="corp__text">
                  <h3>{row.title}</h3>
                  {row.subtitle && <p class="corp__subtitle">{row.subtitle}</p>}
                  <p class="corp__desc">{row.desc}</p>
                  {row.pills && row.pills.length > 0 && (
                    <ul class="corp__pills">
                      {row.pills.map((pill) => (
                        <li>{pill}</li>
                      ))}
                    </ul>
                  )}
                </div>
                <span class="corp__arrow" aria-hidden="true">
                  <Icon name="arrow-right" size={20} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      {
        hasAfter && (
          <div class="corp__after">
            <slot name="after" />
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  import '../../scripts/reveal';
  import '../../scripts/lordicon';
</script>

<style>
  .corp {
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--white);
    background:
      radial-gradient(ellipse 55% 60% at 92% 0%, rgba(255, 145, 77, 0.18), transparent 60%),
      radial-gradient(ellipse 60% 70% at 0% 100%, rgba(0, 74, 173, 0.55), transparent 65%),
      var(--blue-900);
  }

  .corp::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 48px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 48px);
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
  }

  .corp__inner {
    display: grid;
    gap: var(--s-12);
    padding-block: var(--s-6);
  }

  .corp__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    letter-spacing: 0.14em;
    margin-bottom: var(--s-4);
  }

  .corp__eyebrow::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--orange-500);
  }

  .corp h2 {
    font-size: var(--fs-4xl);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--white);
  }

  .corp__body {
    margin-top: var(--s-6);
    max-width: 48ch;
    font-size: var(--fs-md);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.78);
  }

  .corp__actions {
    margin-top: var(--s-8);
  }

  .corp__actions :global(.btn--primary) {
    transition:
      background-color 0.25s ease-out,
      border-color 0.25s ease-out,
      box-shadow 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .corp__actions :global(.btn--primary:hover) {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px -10px rgba(255, 145, 77, 0.65);
  }

  .corp__rows {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .corp__rows > li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .corp__row {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-6) var(--s-4);
    color: var(--white);
    text-decoration: none;
    border-radius: var(--radius);
    transition:
      background-color 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .corp__row:hover,
  .corp__row:focus-visible {
    background: rgba(255, 255, 255, 0.06);
  }

  .corp__row:focus-visible {
    outline-offset: 4px;
  }

  .corp__num {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--orange-500);
    min-width: 1.75rem;
  }

  .corp__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    transition: background-color 0.35s var(--ease-out), border-color 0.35s var(--ease-out);
  }

  .corp__row:hover .corp__icon,
  .corp__row:focus-visible .corp__icon {
    background: rgba(255, 145, 77, 0.14);
    border-color: rgba(255, 145, 77, 0.4);
  }

  .corp__text {
    transition: transform 0.35s var(--ease-out);
  }

  .corp__row:hover .corp__text,
  .corp__row:focus-visible .corp__text {
    transform: translateX(6px);
  }

  .corp__text h3 {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.25;
    color: var(--white);
  }

  .corp__subtitle {
    margin-top: var(--s-1);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--orange-500);
  }

  .corp__desc {
    margin-top: var(--s-1);
    font-size: var(--fs-base);
    color: rgba(255, 255, 255, 0.72);
  }

  .corp__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }

  .corp__pills li {
    padding: 0.2rem 0.65rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-pill);
  }

  .corp__arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: var(--white);
    transition:
      background-color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .corp__row:hover .corp__arrow,
  .corp__row:focus-visible .corp__arrow {
    background: var(--orange-650);
    border-color: var(--orange-650);
    color: var(--white);
    transform: translateX(4px);
  }

  .corp__after {
    margin-top: var(--s-6);
    font-size: var(--fs-sm);
    font-style: italic;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 599px) {
    .corp__row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      padding-inline: var(--s-2);
    }

    .corp__num {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .corp__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--s-16);
      align-items: start;
      padding-block: var(--s-10);
    }

    .corp__intro {
      position: sticky;
      top: calc(var(--header-h, 72px) + var(--s-8));
    }

    .corp__rows {
      margin-top: var(--s-2);
    }

    .corp__row {
      padding-block: var(--s-8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .corp__row,
    .corp__icon,
    .corp__text,
    .corp__arrow,
    .corp__actions :global(.btn--primary) {
      transition: none;
    }

    .corp__row:hover .corp__text,
    .corp__row:focus-visible .corp__text,
    .corp__row:hover .corp__arrow,
    .corp__row:focus-visible .corp__arrow {
      transform: none;
    }
  }
</style>
