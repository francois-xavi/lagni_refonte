---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'outline' | 'outlineLight' | 'ghost' | 'white';
  size?: 'md' | 'lg';
  icon?: IconName | null;
  class?: string;
  id?: string;
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon = 'arrow-right',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
---

<Tag class={classes} href={href} type={href ? undefined : type} {...rest}>
  <span><slot /></span>
  {icon && <Icon name={icon} size={17} class="btn__icon" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    border: 1.5px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }

  /* Long labels must wrap on phones instead of widening their container. */
  @media (max-width: 639px) {
    .btn {
      max-width: 100%;
      white-space: normal;
      text-align: center;
    }
  }

  .btn--md {
    padding: 0.7rem 1.15rem;
    font-size: var(--fs-base);
  }

  .btn--lg {
    padding: 0.85rem 1.5rem;
    font-size: var(--fs-md);
  }

  .btn :global(.btn__icon) {
    flex-shrink: 0;
    transition: transform 0.18s ease;
  }

  .btn:hover :global(.btn__icon) {
    transform: translateX(3px);
  }

  /* White on --orange-500 fails AA; the darker action fill keeps 4.6:1. */
  .btn--primary {
    background: var(--orange-650);
    border-color: var(--orange-650);
    color: var(--white);
  }

  .btn--primary:hover {
    background: var(--orange-700);
    border-color: var(--orange-700);
    color: var(--white);
  }

  .btn--outline {
    background: var(--white);
    border-color: var(--blue-700);
    color: var(--blue-700);
  }

  .btn--outline:hover {
    background: var(--blue-050);
    color: var(--blue-800);
  }

  .btn--outlineLight {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.75);
    color: var(--white);
  }

  .btn--outlineLight:hover {
    background: rgba(255, 255, 255, 0.14);
    color: var(--white);
  }

  .btn--white {
    background: var(--white);
    border-color: var(--white);
    color: var(--blue-700);
  }

  .btn--white:hover {
    background: var(--blue-050);
    color: var(--blue-800);
  }

  .btn--ghost {
    background: transparent;
    border-color: transparent;
    color: var(--blue-700);
    padding-inline: 0;
  }

  .btn--ghost:hover {
    color: var(--blue-500);
    text-decoration: underline;
  }

  .btn[disabled],
  .btn[aria-disabled='true'] {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>
