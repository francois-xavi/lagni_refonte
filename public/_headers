# En-têtes HTTP — format Cloudflare Pages (lu aussi par Netlify).
# Copié tel quel dans dist/ au build.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # Le site ne charge aucun script tiers ; à élargir si un outil de mesure
  # d'audience est ajouté un jour.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Les fichiers générés par Astro portent un hash dans leur nom : ils peuvent
# être mis en cache indéfiniment.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=2592000
